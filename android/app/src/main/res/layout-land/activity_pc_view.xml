<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/nous_background">

    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@id/nous_navigation"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:backgroundTint="@color/nous_surface"
        app:elevation="0dp"
        app:itemIconTint="@color/nous_navigation_item"
        app:itemMinHeight="56dp"
        app:itemSpacing="4dp"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/nous_navigation"
        app:menuGravity="center"
        app:contentMarginTop="0dp"
        app:paddingBottomSystemWindowInsets="false"
        app:paddingStartSystemWindowInsets="false"
        app:paddingTopSystemWindowInsets="false"
        app:shapeAppearanceOverlay="@style/Nous.NavigationRailShape" />

    <include
        layout="@layout/nous_pc_tabs"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
