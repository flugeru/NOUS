<?xml version="1.0" encoding="utf-8"?>
<GridView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragmentView"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:numColumns="@integer/nous_game_grid_columns"
    android:columnWidth="@dimen/nous_game_grid_column_width"
    android:stretchMode="columnWidth"
    android:paddingStart="@dimen/nous_main_content_inset"
    android:paddingEnd="@dimen/nous_main_content_inset"
    android:paddingTop="4dp"
    android:paddingBottom="16dp"
    android:horizontalSpacing="10dp"
    android:verticalSpacing="12dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipToPadding="false"
    android:gravity="center"/>