<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nous_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="8dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:letterSpacing="0.09"
            android:text="@string/app_label"
            android:textColor="@color/nous_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/helpButton"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/help"
            android:src="@drawable/ic_help" />
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/profilesButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/profile_manager_choose_profile"
            app:icon="@drawable/ic_profiles"
            app:iconSize="22dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/Nous.Title"
        android:text="@string/nous_computers" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="12dp"
        android:textAppearance="@style/Nous.Subtitle"
        android:text="@string/nous_computers_hint" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <FrameLayout
            android:id="@+id/pcFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <LinearLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/nous_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="18dp">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/nous_secondary" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/Nous.Subtitle"
                android:text="@string/searching_pc" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/manuallyAddPc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="8dp"
        android:text="@string/title_add_pc"
        app:icon="@drawable/ic_add_base"
        app:iconGravity="textStart" />

    <include layout="@layout/nous_navigation" />
</LinearLayout>
