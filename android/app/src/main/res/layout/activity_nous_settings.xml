<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/nous_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="@dimen/nous_settings_inset">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/nous_settings" android:textAppearance="@style/Nous.Title" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:layout_marginBottom="10dp"
                android:text="@string/nous_settings_hint" android:textAppearance="@style/Nous.Subtitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Nous.SettingsSectionLabel"
                android:layout_marginBottom="@dimen/nous_settings_row_gap"
                android:text="@string/nous_streaming" />
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/nous_settings_hub_columns"
                android:orientation="horizontal">
                <LinearLayout android:id="@+id/nous_settings_video"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_video_audio" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_video_audio" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_video_summary"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/nous_settings_profiles"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_stream_profiles" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_profiles" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_profiles_short"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/nous_settings_controls"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_controls" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_controls" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_controls_summary"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/nous_settings_advanced"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_advanced" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_advanced" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_advanced_summary"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/nous_settings_development"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_advanced" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_development" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_development_summary"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
            </GridLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/Nous.SettingsSectionLabel"
                android:layout_marginBottom="@dimen/nous_settings_row_gap"
                android:text="@string/nous_support" />
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/nous_settings_hub_columns"
                android:orientation="horizontal">
                <LinearLayout android:id="@+id/nous_settings_diagnostics"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_device_diagnostics" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_diagnostics" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_diagnostics_summary"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:id="@+id/nous_settings_help"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginStart="@dimen/nous_settings_hub_column_gap"
                    android:layout_marginEnd="@dimen/nous_settings_hub_column_gap"
                    android:minHeight="@dimen/nous_settings_hub_row_height" android:layout_marginBottom="@dimen/nous_settings_row_gap"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/nous_preference_ripple" android:focusable="true"
                    android:clickable="true"
                    android:paddingStart="@dimen/nous_settings_row_inset" android:paddingEnd="@dimen/nous_settings_row_inset"
                    android:paddingTop="@dimen/nous_settings_hub_row_padding"
                    android:paddingBottom="@dimen/nous_settings_hub_row_padding">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp"
                        android:importantForAccessibility="no" android:tint="@color/nous_secondary"
                        android:src="@drawable/ic_help" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/nous_help" android:textColor="@color/nous_text"
                            android:textStyle="bold" android:textSize="16sp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="3dp" android:text="@string/nous_help_summary"
                            android:textAppearance="@style/Nous.Subtitle" />
                    </LinearLayout>
                </LinearLayout>
            </GridLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
