<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/nous_pair_host"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/Nous.Subtitle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:layout_marginBottom="16dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/nous_pin_0"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/nous_card"
            android:gravity="center" android:fontFamily="monospace"
            android:textColor="@color/nous_text" android:textSize="28sp" />
        <TextView android:id="@+id/nous_pin_1"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/nous_card"
            android:gravity="center" android:fontFamily="monospace"
            android:textColor="@color/nous_text" android:textSize="28sp" />
        <TextView android:id="@+id/nous_pin_2"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_weight="1"
            android:layout_marginEnd="8dp" android:background="@drawable/nous_card"
            android:gravity="center" android:fontFamily="monospace"
            android:textColor="@color/nous_text" android:textSize="28sp" />
        <TextView android:id="@+id/nous_pin_3"
            android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_weight="1"
            android:background="@drawable/nous_card"
            android:gravity="center" android:fontFamily="monospace"
            android:textColor="@color/nous_text" android:textSize="28sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pair_pairing_help" android:textAppearance="@style/Nous.Subtitle" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="@string/nous_waiting_for_pc"
        android:textColor="@color/nous_secondary" />
</LinearLayout>
