<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/nous_page_header_height"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@id/nous_back"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/nous_back"
            android:src="@drawable/ic_nous_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nous_osc_editor_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <ImageButton
            android:id="@+id/nous_osc_undo"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/nous_osc_undo"
            android:src="@drawable/ic_nous_osc_undo" />

        <ImageButton
            android:id="@+id/nous_osc_redo"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/nous_osc_redo"
            android:src="@drawable/ic_nous_osc_redo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nous_osc_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nous_save_controls"
            app:backgroundTint="@color/nous_secondary"
            android:textColor="@color/nous_on_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nous_osc_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/nous_osc_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ScrollView
            android:id="@+id/nous_osc_inspector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/nous_card"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/nous_osc_panel_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/nous_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nous_osc_pick"
                    style="@style/NousOscAction"
                    android:layout_width="wrap_content"
                    android:text="@string/nous_osc_pick_title" />

                <TextView
                    android:id="@+id/nous_osc_size_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/nous_osc_size"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <SeekBar
                    android:id="@id/nous_osc_size"
                    style="@style/NousOscSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/nous_osc_opacity_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@+id/nous_osc_opacity"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <SeekBar
                    android:id="@id/nous_osc_opacity"
                    style="@style/NousOscSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/nous_osc_visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/nous_osc_visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nous_osc_reset"
                    style="@style/NousOscAction"
                    android:layout_width="wrap_content"
                    android:text="@string/nous_osc_reset" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_osc_tool_move"
                style="@style/NousOscAction"
                android:layout_width="wrap_content"
                android:text="@string/nous_move" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_osc_tool_size"
                style="@style/NousOscAction"
                android:layout_width="wrap_content"
                android:text="@string/nous_osc_tool_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_osc_tool_opacity"
                style="@style/NousOscAction"
                android:layout_width="wrap_content"
                android:text="@string/nous_osc_tool_opacity" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_osc_tool_visible"
                style="@style/NousOscAction"
                android:layout_width="wrap_content"
                android:text="@string/nous_osc_tool_visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_osc_tool_layout"
                style="@style/NousOscAction"
                android:layout_width="wrap_content"
                android:text="@string/nous_osc_tool_layout" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_osc_tool_test"
                style="@style/NousOscAction"
                android:layout_width="wrap_content"
                android:text="@string/nous_osc_tool_test" />

        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
