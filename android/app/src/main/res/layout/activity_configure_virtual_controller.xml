<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nous_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/nous_page_header_height"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@id/nous_back"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/nous_back"
            android:src="@drawable/ic_nous_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nous_osc_editor_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nous_osc_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nous_save_controls"
            app:backgroundTint="@color/nous_secondary"
            android:textColor="@color/nous_on_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nous_osc_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/nous_settings_inset"
        android:paddingEnd="@dimen/nous_settings_inset"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/nous_osc_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:id="@+id/nous_osc_inspector"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/nous_osc_editor_hint"
                    android:textAppearance="@style/Nous.Subtitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/nous_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nous_osc_pick"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewStart"
                        app:icon="@drawable/ic_controls"
                        app:iconTint="@color/nous_secondary" />

                    <TextView
                        android:id="@+id/nous_osc_size_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:labelFor="@+id/nous_osc_size"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <SeekBar
                        android:id="@id/nous_osc_size"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:progressTint="@color/nous_secondary"
                        android:thumbTint="@color/nous_secondary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/nous_osc_visible"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/nous_osc_visible" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/nous_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/nous_osc_opacity_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/nous_osc_opacity"
                        android:textAppearance="?attr/textAppearanceLabelLarge" />

                    <SeekBar
                        android:id="@id/nous_osc_opacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:max="100"
                        android:progressTint="@color/nous_secondary"
                        android:thumbTint="@color/nous_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/nous_osc_reset"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nous_osc_reset" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
