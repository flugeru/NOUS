<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nous_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/nous_page_header_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/nous_back"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/nous_back"
            android:src="@drawable/ic_nous_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/nous_diagnostics"
            android:textColor="@color/nous_text"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/nous_settings_inset">
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/nous_settings_hub_columns"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_vibrator"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginHorizontal="@dimen/nous_settings_hub_column_gap"
                    android:layout_height="wrap_content"
                    android:onClick="onClick"
                    android:text="@string/debug_info_test_device_vibration" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_update_gamepad"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginHorizontal="@dimen/nous_settings_hub_column_gap"
                    android:layout_height="wrap_content"
                    android:onClick="onClick"
                    android:text="@string/debug_info_refresh_gamepad_list" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_vibrator_gamepad"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill_horizontal"
                    android:layout_marginHorizontal="@dimen/nous_settings_hub_column_gap"
                    android:layout_height="wrap_content"
                    android:onClick="onClick"
                    android:text="@string/debug_info_test_gamepad_rumble" />

            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_vibrator_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="onClick"
                    android:text="@string/debug_info_vibration_amplitude" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_vibrator_cancle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:onClick="onClick"
                    android:text="@string/debug_info_stop_vibration" />
            </LinearLayout>

            <TextView
                android:id="@+id/tx_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/nous_card"
                android:textAppearance="@style/Nous.Subtitle"
                android:padding="@dimen/nous_settings_row_inset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/debug_info_refresh_gamepad_info" />

            <TextView
                android:id="@+id/tx_game_pad_info"
                android:layout_marginTop="8dp"
                android:background="@drawable/nous_card"
                android:fontFamily="monospace"
                android:textColor="@color/nous_secondary"
                android:padding="@dimen/nous_settings_row_inset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/nous_copy_diagnostics" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:text="@string/nous_copy_diagnostics" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
