<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/nous_card_ripple">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@android:id/title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/nous_text"
            android:textSize="16sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@android:id/summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textAppearance="@style/Nous.Subtitle" />
    </LinearLayout>
    <LinearLayout android:id="@android:id/widget_frame" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:gravity="center_vertical" />
</LinearLayout>
