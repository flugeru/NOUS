<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/nous_card_ripple"
    android:padding="2dp">
    <include layout="@layout/nous_game_cover" />
    <TextView
        android:id="@+id/grid_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="@integer/nous_game_title_lines"
        android:maxLines="@integer/nous_game_title_lines"
        android:ellipsize="end"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="@dimen/nous_game_title_vertical_padding"
        android:paddingBottom="@dimen/nous_game_title_vertical_padding"
        android:textColor="@color/nous_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
