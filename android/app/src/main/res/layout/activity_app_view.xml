<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nous_background">
    <LinearLayout
        android:id="@+id/nous_library_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">
        <ImageButton
            android:id="@+id/nous_back"
            style="@style/Nous.IconButton"
            android:contentDescription="@string/nous_back"
            android:src="@drawable/ic_nous_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/nous_library"
            android:textColor="@color/nous_text"
            android:textSize="18sp"
            android:textStyle="bold" />
        <include layout="@layout/nous_profile_button" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/nous_tab_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/nous_main_tab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
          <TextView
                android:id="@+id/appListText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/nous_main_content_inset"
                android:paddingEnd="@dimen/nous_main_content_inset"
                android:paddingTop="6dp"
                android:paddingBottom="12dp"
                android:textAppearance="@style/Nous.Title"
                android:ellipsize="end"
                android:maxLines="2" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Nous.InputField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/nous_main_content_inset"
                android:layout_marginEnd="@dimen/nous_main_content_inset"
                android:layout_marginBottom="8dp"
                app:startIconDrawable="@drawable/ic_nous_search">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nous_game_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:hint="@string/nous_search_library"
                    android:imeOptions="actionSearch"
                    android:inputType="textFilter"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <include layout="@layout/nous_offline_categories" />

            <include layout="@layout/nous_library_filters" />
            <include layout="@layout/nous_library_grid" />
        </LinearLayout>
    </FrameLayout>
    <include layout="@layout/nous_navigation" />
</LinearLayout>
