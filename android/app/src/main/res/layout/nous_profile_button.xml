<com.google.android.material.button.MaterialButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profilesButton"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:minWidth="48dp"
    android:maxWidth="176dp"
    android:paddingStart="13dp"
    android:paddingEnd="13dp"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:contentDescription="@string/profile_manager_choose_profile"
    android:textColor="@color/nous_secondary"
    app:backgroundTint="@color/nous_secondary_container"
    app:cornerRadius="24dp"
    app:icon="@drawable/ic_profiles"
    app:iconGravity="textStart"
    app:iconPadding="0dp"
    app:iconSize="22dp"
    app:iconTint="@color/nous_secondary" />
