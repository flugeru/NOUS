<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nous_offline_categories"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/nous_main_content_inset"
    android:layout_marginEnd="@dimen/nous_main_content_inset"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:checkedButton="@+id/nous_offline_games"
    android:orientation="horizontal"
    android:visibility="gone">

    <RadioButton
        android:id="@+id/nous_offline_desktop"
        style="@style/Nous.LibraryCategory"
        android:text="@string/nous_demo_desktop" />

    <RadioButton
        android:id="@id/nous_offline_games"
        style="@style/Nous.LibraryCategory"
        android:text="@string/nous_games" />

    <RadioButton
        android:id="@+id/nous_offline_launchers"
        style="@style/Nous.LibraryCategory"
        android:text="@string/nous_demo_launchers" />
</RadioGroup>
