<com.google.android.material.chip.ChipGroup
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nous_offline_categories"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/nous_main_content_inset"
    android:layout_marginEnd="@dimen/nous_main_content_inset"
    android:layout_marginBottom="4dp"
    android:visibility="gone"
    app:selectionRequired="true"
    app:singleSelection="true">
    <com.google.android.material.chip.Chip
        android:id="@+id/nous_offline_games"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="@string/nous_games" />
    <com.google.android.material.chip.Chip
        android:id="@+id/nous_offline_launchers"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nous_demo_launchers" />
</com.google.android.material.chip.ChipGroup>
