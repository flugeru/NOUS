<com.google.android.material.materialswitch.MaterialSwitch
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@android:id/checkbox" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:layout_marginStart="10dp"
    android:minHeight="0dp" android:gravity="center_vertical"
    android:background="@null"
    app:thumbTint="@color/nous_switch_thumb"
    app:trackTint="@color/nous_switch_track"
    app:trackDecorationTint="@color/nous_switch_track_outline"
    android:focusable="false" android:clickable="false"
    android:importantForAccessibility="no" />
