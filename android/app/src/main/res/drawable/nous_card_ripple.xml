<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3383DBE4">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nous_surface_high" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="@color/nous_secondary" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nous_surface_high" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="@color/nous_secondary" />
                </shape>
            </item>
            <item android:drawable="@drawable/nous_card" />
        </selector>
    </item>
</ripple>
